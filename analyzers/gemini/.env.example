# 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 키를 입력하세요.
# 예: cp .env.example .env
#
# Gemini API 키 발급: https://aistudio.google.com/apikey

# ---------------------------------------------------------------------------
# 단일 키 설정 (reel_analyzer.py에서 지원, 복수 설정이 우선)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=여기에_발급받은_API_키를_붙여넣으세요
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# 키/모델 풀 설정 (reel_analyzer.py에서 지원)
# ---------------------------------------------------------------------------
# 쉼표로 구분해서 키를 몇 개든 추가할 수 있습니다. (예: 3개 -> 나중에 5개로 확장해도 그대로 동작)
# 주의: 반드시 서로 다른 프로젝트에서 발급한 키여야 로테이션 효과가 있습니다.
#       같은 프로젝트 소속 키는 한도를 공유하기 때문에 여러 개 등록해도 소용없습니다.
GEMINI_API_KEYS=키1,키2,키3

# (선택) 로그에 표시될 키 라벨. 키 순서와 맞춰서 적으세요. 안 적으면 key1, key2 ... 로 자동 라벨링.
GEMINI_API_KEY_LABELS=acct1,acct2,acct3

# 로테이션에 사용할 모델 목록 (쉼표 구분). 필요하면 추가/삭제하세요.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash

# 공용 시트 풀 (기본값 sheets). 설정 누락/통신 실패 시 로컬로 자동 전환하지 않습니다.
GEMINI_POOL_MODE=sheets
GEMINI_POOL_URL=
GEMINI_POOL_TOKEN=
GEMINI_POOL_USER=
# URL/토큰 설정 방법: sheets_pool/README.md
# 로컬 단독 동작이 필요할 때만 GEMINI_POOL_MODE=local로 명시하세요.

