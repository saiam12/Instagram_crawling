# Local secrets (keep shareable templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template
cookies.txt
*.cookies.txt

# Local agent instructions
skill.md
AGENTS.md

# Dependencies and Python caches
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Temporary files, Excel lock files, and OS metadata
*.log
*.tmp
*.temp
~$*.xlsx
.DS_Store
Thumbs.db
Desktop.ini

# Shared generated state and browser profiles
.android/
outputs/
graphify-out/
browser_profile/
.collector/
.datasets/
.collection-paused

# Collector data (including refresh/test data) and runtime state
/collectors/data/
/collectors/data_*/
/collectors/runtime/
/collectors/logs/

# Loose collector exports
/collectors/*.csv
/collectors/*.json
!/collectors/refresh.example.json
# Explicitly protect the per-computer refresh configuration.
/collectors/refresh.local.json
/collectors/*.jsonl
/collectors/*.log
/collectors/*.xlsx
/collectors/*.html

# Analyzer runtime files
/analyzers/.pool_pending/
/analyzers/model_limits.json
/analyzers/output/
/analyzers/downloads/

# Local archives, experiments, and agent workspaces
/archives/
/docs/archive/
/docs/superpowers/
/collectors/monitor/docs/premium-audit.json
/temp/
/unused/
/.superpowers/
/collectors/scratch/

# Generated standalone HTML snapshots
/instagram_monitoring_dashboard.html
/video_recommendation_cached.html

# Legacy generated directories: keep restored old data out of Git
/collectors/unused/
/collectors/*/data_*/
