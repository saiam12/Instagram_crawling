# Copy this file to .env and fill in the values.
# Use a long-lived access token. Never commit the real .env file.
INSTAGRAM_ACCESS_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN
INSTAGRAM_IG_USER_ID=YOUR_AUTHORIZED_INSTAGRAM_PROFESSIONAL_ACCOUNT_ID
INSTAGRAM_API_VERSION=v26.0

# Optional. The default is the data folder beside instagram_collector.py.
# INSTAGRAM_DATA_DIR=C:\instagram_data_set\data
